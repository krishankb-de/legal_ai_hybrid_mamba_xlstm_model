*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
.venv-vllm/
venv/
env/

# Upstream reference checkout: read-only, never committed
Reference/

# Weights and data (small test fixtures are allowed further down)
*.pth
*.pt
*.ckpt
*.safetensors
*.parquet
*.hdf5
*.h5
data/raw/
data/shards/
data/hf/
data/index/
data/cache/
