data/probes/

# Run outputs and pulled cluster logs
outputs/
checkpoints/
logs/
cluster/
wandb/
lightning_logs/
.hydra/
multirun/

# Test and tool caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
junit*.xml
htmlcov/

# Code knowledge graph (graphify): only the graph, its report and viewer are tracked
graphify-out/*
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md

# OS and editor
.DS_Store
Thumbs.db

# Local configuration
.sync_stamp
scripts/slurm/cluster.env
scripts/validate.local.sh
.rsync-exclude.local

# Allowed exceptions
!tests/fixtures/**
!data/manifests/**
