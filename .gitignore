coverage.xml
junit*.xml
htmlcov/

# OS
.DS_Store
Thumbs.db

# Local, user-specific
.sync_stamp
scripts/slurm/cluster.env

# Markdown is denied by default and allowed by name, so stray notes never get committed.
*.md
!README.md
!CLAUDE.md
!LEGAL_BUILD_PLAN.md
!Docs/*.md
!analysis/*.md
!analysis/**/*.md

# Allowed exceptions
!tests/fixtures/**
!data/manifests/**
