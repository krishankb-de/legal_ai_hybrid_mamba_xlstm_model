# Copy to scripts/slurm/cluster.env (gitignored, rsync-excluded) and fill in.
# Sourced on your workstation before every ssh one-liner: `source scripts/slurm/cluster.env`.

# ssh alias from ~/.ssh/config; `ssh $CLUSTER_HOST true` must exit 0
CLUSTER_HOST=gpu-cluster
# repo checkout on the cluster (sync target of scripts/sync_to_cluster.sh)
CLUSTER_REPO=/sc/home/<user>/lexhybrid
# outputs/, HF_HOME, inductor caches; needs >= 300 GB free
SCRATCH_ROOT=/sc/scratch/<user>/lexhybrid
